# Example .env to build firmware with OTA enabled.
# This file is safe to commit; your real ".env" with credentials is ignored by git.

# Wi-Fi
WIFI_SSID=Tenda_A05E38
WIFI_PASSWORD=

# EC2 esp32-server base URL
# Prod: 5000 | Test: 5002
SERVER_BASE=http://54.91.172.66:5000

# Relay mode: IP camera snapshot endpoint + credentials
IP_CAM_URL=http://192.168.0.142/snap.jpg
IP_CAM_USER=admin
IP_CAM_PASS=admin

# Common timing
TIMER_DELAY_MS=30000

# If you switch SERVER_BASE to https://, this controls TLS verification.
TLS_INSECURE=1

# Device identification (used for remote config endpoints)
DEVICE_ID=esp32-001

# OTA (ESP pulls updates from server)
OTA_ENABLED=1
# If empty, defaults to ${SERVER_BASE}/ota/manifest.txt
OTA_MANIFEST_URL=
# IMPORTANT: bump this on every build, so the device can tell updates apart.
OTA_CURRENT_VERSION=2026-02-07_1
OTA_CHECK_INTERVAL_MS=600000
# Optional token if your server protects /ota/*
OTA_ADMIN_TOKEN=

# Remote config (optional)
REMOTE_CONFIG_ENABLED=0
REMOTE_CONFIG_URL=
REMOTE_CONFIG_CHECK_INTERVAL_MS=60000

