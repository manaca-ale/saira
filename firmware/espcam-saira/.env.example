# Shared config for both firmwares (loaded at build-time by PlatformIO).

# Wi-Fi
WIFI_SSID=YOUR_WIFI
WIFI_PASSWORD=YOUR_PASSWORD

# Server base URL (http:// or https://)
SERVER_BASE=http://example.com

# Relay mode: IP camera snapshot endpoint + credentials
IP_CAM_URL=http://192.168.0.142/snap.jpg
IP_CAM_USER=admin
IP_CAM_PASS=admin

# Common timing
TIMER_DELAY_MS=30000

# TLS behavior for https:// SERVER_BASE in ipcam-relay (1=insecure, 0=validate with CA)
TLS_INSECURE=1

