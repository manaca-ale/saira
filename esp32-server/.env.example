# Used by esp32-server docker-compose.*.yml
# Copy to .env on the EC2 host (do not commit .env).

# Used to generate absolute URLs in responses (optional).
# Example: http://54.91.172.66:5000
PUBLIC_BASE_URL=

# Where to store uploaded images, OTA binaries, and per-device config (inside container).
UPLOAD_DIR=/app/uploads
OTA_DIR=/app/ota
CONFIG_DIR=/app/config

# Optional: protect admin endpoints (/ota/upload and /device/<id>/config)
ADMIN_TOKEN=

