# Used by esp32-server docker-compose.*.yml
# Copy to .env on the EC2 host (do not commit .env).

# Used to generate absolute URLs in responses (optional).
# Example: http://54.91.172.66:5000
PUBLIC_BASE_URL=

# Where to store uploaded images, OTA binaries, and per-device config (inside container).
UPLOAD_DIR=/app/uploads
OTA_DIR=/app/ota
CONFIG_DIR=/app/config

# Optional: protect admin endpoints (/ota/upload and /device/<id>/config)
ADMIN_TOKEN=
# Autenticação da borda. Com EDGE_AUTH_REQUIRED=false (padrão) nada é recusado:
# o pedido sem token só aparece no log como [EDGE-AUTH]. Ligar (true) só depois
# de todas as câmeras mandarem X-Device-Token e de backend/worker mandarem
# X-Admin-Token (ESP32_ADMIN_TOKEN = este ADMIN_TOKEN).
EDGE_AUTH_REQUIRED=false
# Um token por câmera: "pi-cam-001:token1,pi-cam-002:token2"
EDGE_DEVICE_TOKENS=
# Token único para dispositivo sem token próprio (ex.: simulador de câmera)
EDGE_SHARED_TOKEN=

# Login do painel antigo de câmeras (/dashboard) no backend. Sem a senha o
# esp32-server não tenta entrar (não existe mais senha padrão no código).
CORE_API_LOGIN_EMAIL=admin@saira.com
CORE_API_LOGIN_PASSWORD=

# Global fallback remote-config when device-specific config file is missing.
# This is consumed by GET /device/<id>/config.txt.
DEFAULT_TIMER_DELAY_MS=10000
DEFAULT_CONFIG_VERSION=2026-03-08_timer10s
DEFAULT_CONFIG_FILE=default.txt

# Gunicorn tuning for slow/concurrent ESP32 uploads.
GUNICORN_WORKERS=4
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=65
GUNICORN_LOG_LEVEL=info

# Logging volume control.
UPLOAD_LOG_EVERY=20
# 0 disables per-upload [DEVICE] stdout line (events are still persisted to JSONL).
UPLOAD_EVENT_PRINT_EVERY=0

# Capture-interval sync (GET /config/device/<id>).
# Fallback used when the device is not registered or the backend is unavailable.
# Valid range enforced server-side: 5–10 seconds.
DEFAULT_CAPTURE_INTERVAL=10

