# AWS Rekognition (standard DetectLabels, no custom labels)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REKOGNITION_WASTE_DECISION_MODE=binary
REKOGNITION_WASTE_LABELS=Garbage,Trash,Waste,Debris,Litter,Junk,Refuse,Landfill
REKOGNITION_WASTE_MIN_CONFIDENCE=70
REKOGNITION_WASTE_TYPE_VALUE=Entulho
REKOGNITION_OFFENDER_MODE=detect_labels
REKOGNITION_OFFENDER_LABELS=Person,Car,Truck,Bus,Motorcycle,Bicycle
REKOGNITION_OFFENDER_MIN_CONFIDENCE=70
REKOGNITION_MAX_LABELS=50
REKOGNITION_MAX_RETRIES=3
REKOGNITION_TIMEOUT_SECONDS=10
REKOGNITION_MOSAIC_ENABLED=true
REKOGNITION_MOSAIC_BATCH_SIZE=4
REKOGNITION_MOSAIC_TIMEOUT_SECONDS=8
REKOGNITION_MOSAIC_TILE_WIDTH=960
REKOGNITION_MOSAIC_TILE_HEIGHT=720
REKOGNITION_MOSAIC_MAX_PAYLOAD_BYTES=5242880
REKOGNITION_MOSAIC_JPEG_QUALITY_START=90
