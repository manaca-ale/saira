
ENABLE_LOCAL_LOGIN=true
ENABLE_CONECTA_LOGIN=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CAMERA_UPLOADS_DIR=/app/uploads
# Leave empty to return relative URLs (/uploads/...) via the frontend proxy.
CAMERA_UPLOAD_PUBLIC_BASE_URL=
AI_MODE=yolo
GEMINI_API_KEY=
# Vertex AI keyless (WIF). Set GEMINI_USE_VERTEX=true + GCP_PROJECT to bill via
# Cloud Billing (pay-as-you-go) instead of the AI Studio prepaid key. Needs the
# vertex-cred-config.json mounted and GOOGLE_APPLICATION_CREDENTIALS pointing at it.
GEMINI_USE_VERTEX=false
GCP_PROJECT=
GCP_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_RETRIES=2
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_CASCADE_ENABLED=false
GEMINI_CASCADE_WINDOW_SECONDS=120
GEMINI_CASCADE_MAX_FRAMES=12
GEMINI_CASCADE_MIN_FRAMES=6
GEMINI_AGENT1_MODEL=gemini-2.5-flash
GEMINI_AGENT1_TIMEOUT_SECONDS=15
GEMINI_AGENT1_TRIGGER_MIN_CONFIDENCE=75
GEMINI_AGENT1_MAX_OUTPUT_TOKENS=4096
# gemini-2.5-flash pricing (non-thinking, USD per 1M tokens)
GEMINI_INPUT_TOKEN_PRICE_PER_1M=0.15
GEMINI_OUTPUT_TOKEN_PRICE_PER_1M=0.60
CONECTA_ENV=test
CONECTA_BASE_URL_TEST=https://loginteste.recife.pe.gov.br
CONECTA_BASE_URL_PROD=https://login.recife.pe.gov.br
CONECTA_REALM=recife
CONECTA_CLIENT_ID=
CONECTA_CLIENT_SECRET=
CONECTA_REDIRECT_URI=
CONECTA_POST_LOGOUT_REDIRECT_URI=
CONECTA_SCOPE=openid profile email
CONECTA_STATE_TTL_SECONDS=600
CONECTA_TICKET_TTL_SECONDS=120
CONECTA_HTTP_TIMEOUT_SECONDS=15

# S3 daily migration (worker syncs D-1 images to S3 at S3_SYNC_HOUR BRT)
S3_ENABLED=false
S3_BUCKET_NAME=saira-images
S3_REGION=sa-east-1
S3_SYNC_HOUR=3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

WHATSAPP_PROVIDER=waha
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=0c21f39932ff4d00822d5ec9ae2d2943
WAHA_SESSION_NAME=default
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=admin123
META_API_TOKEN=your-meta-api-token
META_PHONE_ID=your-meta-phone-id
WEB_APP_URL=http://localhost:3000
ENABLE_WHATSAPP_TEST_ROUTE=false
WHATSAPP_TEST_RATE_LIMIT_PER_MINUTE=5

# --- Servidor (docs/operacao/servidor-janeiro-2027.md) ---
# Produção e teste têm .env separados desde a separação dos checkouts
# (/home/ubuntu/saira = produção, /home/ubuntu/saira-test = teste); o teste
# ainda lê as variáveis com prefixo TEST_*.
# JWT do backend: obrigatório; sem ele o compose não sobe (openssl rand -hex 32).
SECRET_KEY=
TEST_SECRET_KEY=
# Senhas: só valem na criação do volume. Para trocar num banco existente, siga
# o roteiro (ALTER USER antes de mudar aqui). Use só [0-9a-f] (vai no DATABASE_URL).
POSTGRES_PASSWORD=
TEST_POSTGRES_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
TEST_GRAFANA_ADMIN_PASSWORD=
TEST_PGADMIN_EMAIL=
TEST_PGADMIN_PASSWORD=
# Intervalo entre varreduras do worker (s). Com as Pi (eventos fechados pela
# câmera) é só a espera extra depois do fim do evento: 10 em produção.
# Os 180 de antes eram das ESP32 (janelas de tempo) e somavam até 3 min.
POLL_INTERVAL=10
TEST_POLL_INTERVAL=5
# Câmera sem cadastro ativo: quadros brutos mais velhos que isto (s) vão para
# sem_ocorrencia e saem do disco na migração diária ao S3. Até 3600: a migração
# das 03:00 só pega o dia anterior. 0 = desligado.
INACTIVE_DEVICE_MAX_FRAME_AGE_SECONDS=3600
TEST_INACTIVE_DEVICE_MAX_FRAME_AGE_SECONDS=3600
# Manifestos de evento das Pi já processados, mais velhos que isto (s), vão para
# events/arquivo/AAAAMM: sem isso cada varredura lê todos (0,85 s com 32 mil, uma Pi).
EVENT_MANIFEST_ARCHIVE_AFTER_SECONDS=172800
TEST_EVENT_MANIFEST_ARCHIVE_AFTER_SECONDS=172800

# --- Funil A da campanha 54 (benchmarks/campaigns/54-*/ROLLOUT-2027-01.md) ---
# Tudo desligado por padrão: com estas variáveis vazias o worker faz o que fazia
# antes. No teste, cada uma tem a sua TEST_* (o compose de teste não lê o nome
# da produção para estas). Ligar por passo, só nos dispositivos listados.
# Passo 1, detail novo (Vertex na produção; o teste usa TEST_GEMINI_API_KEY):
#   GEMINI_MODEL=gemini-3.8-flash  GEMINI_DETAIL_PROMPT_VERSION=g3
#   GEMINI_TIMEOUT_SECONDS=90 (obrigatório: p90 de 46,8 s no Vertex)
GEMINI_DETAIL_THINKING_LEVEL=
GEMINI_DETAIL_MEDIA_RESOLUTION=
GEMINI_REQUIRE_BBOX=true
GEMINI_BBOX_MIN_AREA_RATIO=0.01
# Passo 2, filtro Decisions (só existe na API do AI Studio; chave própria):
GATE_PREFILTER_ENABLED=false
GATE_PREFILTER_DEVICES=
GATE_PREFILTER_LOG_ONLY=true
GATE_PREFILTER_THRESHOLD=0.30
GATE_PREFILTER_API_KEY=
GATE_PREFILTER_DAILY_BUDGET_USD=1.00
# Passo 3, gate Amazon Nova Lite no Bedrock (região SHADOW_BEDROCK_REGION,
# credencial AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY com bedrock:InvokeModel).
# Nunca ligar sem o filtro barrando (GATE_PREFILTER_LOG_ONLY=false).
GATE_BEDROCK_ENABLED=false
GATE_BEDROCK_DEVICES=
GATE_BEDROCK_ALIAS=nova-lite
GATE_BEDROCK_FALLBACK_GEMINI=true
# Gate Gemini (reserva do Bedrock): parâmetros dos modelos Gemini 3, vazio = não envia.
GEMINI_AGENT1_THINKING_LEVEL=
GEMINI_AGENT1_MEDIA_RESOLUTION=
GEMINI_GATE_PROMPT_VARIANT=
# Teste: os mesmos nomes com TEST_ na frente (TEST_GATE_PREFILTER_ENABLED, ...),
# mais estas, que sem TEST_ caem no valor de antes:
TEST_GEMINI_MODEL=
TEST_GEMINI_DETAIL_PROMPT_VERSION=
TEST_GEMINI_TIMEOUT_SECONDS=
TEST_GEMINI_AGENT1_MODEL=
TEST_GEMINI_GATE_MID_FRAMES=
TEST_GEMINI_GATE_REVOTE_ENABLED=
TEST_EVENT_DRIVEN_DEVICES=
TEST_AWS_ACCESS_KEY_ID=
TEST_AWS_SECRET_ACCESS_KEY=

# --- Borda: esp32-server (o serviço esp32-server de docker-compose.prod.yml lê daqui) ---
# Token de serviço: backend e worker mandam ESP32_ADMIN_TOKEN em X-Admin-Token.
# Definir primeiro ESP32_ADMIN_TOKEN e só depois ADMIN_TOKEN, com o mesmo valor
# (openssl rand -hex 32). Com ADMIN_TOKEN definido, /device/<id>/config e
# /ota/upload já exigem o token.
ESP32_ADMIN_TOKEN=
ADMIN_TOKEN=
# Token das câmeras. EDGE_AUTH_REQUIRED=false só registra [EDGE-AUTH] no log;
# ligar (true) só quando o log não mostrar mais pedido sem token.
EDGE_AUTH_REQUIRED=false
# Um token por câmera: "pi-cam-001:token1,pi-cam-002:token2"
EDGE_DEVICE_TOKENS=
# Token único para dispositivo sem token próprio (ex.: simulador de câmera)
EDGE_SHARED_TOKEN=
# Login do painel antigo de câmeras do esp32-server no backend. Sem a senha o
# esp32-server não tenta entrar (não existe mais senha padrão no código).
CORE_API_LOGIN_EMAIL=admin@saira.com
CORE_API_LOGIN_PASSWORD=
