
ENABLE_LOCAL_LOGIN=true
ENABLE_CONECTA_LOGIN=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CAMERA_UPLOADS_DIR=/app/uploads
# Leave empty to return relative URLs (/uploads/...) via the frontend proxy.
CAMERA_UPLOAD_PUBLIC_BASE_URL=
AI_MODE=yolo
GEMINI_API_KEY=
# Vertex AI keyless (WIF). Set GEMINI_USE_VERTEX=true + GCP_PROJECT to bill via
# Cloud Billing (pay-as-you-go) instead of the AI Studio prepaid key. Needs the
# vertex-cred-config.json mounted and GOOGLE_APPLICATION_CREDENTIALS pointing at it.
GEMINI_USE_VERTEX=false
GCP_PROJECT=
GCP_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_RETRIES=2
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_CASCADE_ENABLED=false
GEMINI_CASCADE_WINDOW_SECONDS=120
GEMINI_CASCADE_MAX_FRAMES=12
GEMINI_CASCADE_MIN_FRAMES=6
GEMINI_AGENT1_MODEL=gemini-2.5-flash
GEMINI_AGENT1_TIMEOUT_SECONDS=15
GEMINI_AGENT1_TRIGGER_MIN_CONFIDENCE=75
GEMINI_AGENT1_MAX_OUTPUT_TOKENS=4096
# gemini-2.5-flash pricing (non-thinking, USD per 1M tokens)
GEMINI_INPUT_TOKEN_PRICE_PER_1M=0.15
GEMINI_OUTPUT_TOKEN_PRICE_PER_1M=0.60
CONECTA_ENV=test
CONECTA_BASE_URL_TEST=https://loginteste.recife.pe.gov.br
CONECTA_BASE_URL_PROD=https://login.recife.pe.gov.br
CONECTA_REALM=recife
CONECTA_CLIENT_ID=
CONECTA_CLIENT_SECRET=
CONECTA_REDIRECT_URI=
CONECTA_POST_LOGOUT_REDIRECT_URI=
CONECTA_SCOPE=openid profile email
CONECTA_STATE_TTL_SECONDS=600
CONECTA_TICKET_TTL_SECONDS=120
CONECTA_HTTP_TIMEOUT_SECONDS=15

# S3 daily migration (worker syncs D-1 images to S3 at S3_SYNC_HOUR BRT)
S3_ENABLED=false
S3_BUCKET_NAME=saira-images
S3_REGION=sa-east-1
S3_SYNC_HOUR=3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

WHATSAPP_PROVIDER=waha
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=0c21f39932ff4d00822d5ec9ae2d2943
WAHA_SESSION_NAME=default
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=admin123
META_API_TOKEN=your-meta-api-token
META_PHONE_ID=your-meta-phone-id
WEB_APP_URL=http://localhost:3000
ENABLE_WHATSAPP_TEST_ROUTE=false
WHATSAPP_TEST_RATE_LIMIT_PER_MINUTE=5
