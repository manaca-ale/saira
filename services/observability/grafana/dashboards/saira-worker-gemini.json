        {
          "expr": "saira_gemini_estimated_cost_usd_total{agent=\"gate\"}",
          "refId": "B",
          "legendFormat": "cumulative gate"
        },
        {
          "expr": "saira_gemini_estimated_cost_usd_total{agent=\"detail\"}",
          "refId": "C",
          "legendFormat": "cumulative detail"
        },
        {
