        { "expr": "rate(saira_gemini_input_tokens_total{agent=\"gate\"}[5m])", "legendFormat": "gate input/s", "refId": "A" },
        { "expr": "rate(saira_gemini_output_tokens_total{agent=\"gate\"}[5m])", "legendFormat": "gate output/s", "refId": "B" },
        { "expr": "rate(saira_gemini_input_tokens_total{agent=\"detail\"}[5m])", "legendFormat": "detail input/s", "refId": "C" },
        { "expr": "rate(saira_gemini_output_tokens_total{agent=\"detail\"}[5m])", "legendFormat": "detail output/s", "refId": "D" }
      ],
