      "targets": [
        { "expr": "saira_gemini_avg_latency_ms", "refId": "A" }
      ],
      "title": "Avg Latency",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.10 },
              { "color": "red", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(saira_gemini_calls_total{agent=\"detail\"}[5m])) / clamp_min(sum(rate(saira_gemini_calls_total{agent=\"gate\"}[5m])), 0.001)",
          "refId": "A",
          "legendFormat": "gate → detail"
        }
      ],
      "title": "Gate Trigger Rate (5m)",
      "description": "Fraction of Agent-1 gate calls that escalate to Agent-2 detail analysis. Target < 10%.",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum(rate(saira_gemini_latency_seconds_bucket{agent=\"gate\"}[5m])) by (le))",
          "refId": "A",
          "legendFormat": "gate p95"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum(rate(saira_gemini_latency_seconds_bucket{agent=\"detail\"}[5m])) by (le))",
          "refId": "B",
          "legendFormat": "detail p95"
        },
        {
          "expr": "1000 * histogram_quantile(0.50, sum(rate(saira_gemini_latency_seconds_bucket[5m])) by (le))",
          "refId": "C",
          "legendFormat": "all p50"
        }
      ],
      "title": "Gemini Latency by Agent (p95/p50, 5m)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
