[Unit]
Description=SAIRA - Agente de captura (relay de camera IP)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/saira/agent
EnvironmentFile=/opt/saira/agent/.env
ExecStartPre=/bin/mkdir -p /var/spool/saira/frames /var/lib/saira/clips /dev/shm/saira/archive
ExecStart=/opt/saira/venv/bin/python /opt/saira/agent/saira_agent.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
