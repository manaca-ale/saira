# /etc/saira/wan-watchdog.env  (chmod 600 root:root)
# Credenciais da UI web do roteador 4G (Tenda 4G03 Pro) na LAN da Pi.
ROUTER_URL=http://192.168.0.1
ROUTER_USER=admin
ROUTER_PASSWORD=troque-me
# Sondas de WAN: UP se a VPN (EC2) OU qualquer HTTP público responder.
VPN_PEER=10.8.0.1
# WAN_HTTP_PROBES=http://connectivitycheck.gstatic.com/generate_204,http://www.msftconnecttest.com/connecttest.txt
# Política: reboot após 15 min sem WAN; insiste a cada 30 min nas 12 primeiras
# tentativas (em 02/09/2026 a WAN só voltou no 9º reboot seguido) e depois dobra
# o espaçamento até o teto de 4h. Nunca desiste enquanto a WAN estiver morta.
CHECK_INTERVAL_S=60
WAN_DOWN_REBOOT_S=900
REBOOT_RETRY_S=1800
REBOOT_FAST_ATTEMPTS=12
REBOOT_RETRY_MAX_S=14400
# Teto opcional de reboots POR QUEDA (0 = sem teto, recomendado).
MAX_REBOOTS_PER_OUTAGE=0
# OBSOLETO: MAX_REBOOTS_PER_DAY não é mais lido. O teto diário fazia o watchdog
# desistir no meio de uma queda longa (08→09/09/2026: parou às 03:58 e ficou ~20h
# sem tentar). Quem controla a cadência agora é o backoff acima.
STATE_FILE=/var/lib/saira/wan-watchdog.json
