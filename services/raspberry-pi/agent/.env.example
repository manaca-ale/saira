# ============================================================
#  SAIRA — Agente Raspberry Pi (relay de camera IP)
#  Copie para .env e ajuste. O .env e lido por config.py e
#  tambem pelo saira-rtsp-buffer.service (EnvironmentFile).
# ============================================================

# ---- Identidade / destino ----
DEVICE_ID=pi-cam-001
# EC2 dentro do tunel WireGuard (HTTP puro, sem TLS — o WG ja cifra).
EC2_BASE=http://10.8.0.1:5002

# ---- Camera IP (relay) ----
# Snapshot HTTP (pass-through, sem reencode). Defaults iguais ao ipcam_relay.cpp.
#
# Cameras Intelbras VIP "Z"/"Z IA" (firmware Dahua-OEM, ex: VIP 3260 Z IA)
# usam os endpoints CGI da Dahua e exigem auth DIGEST (sem admin/admin de
# fabrica). Use o formato abaixo:
#   IP_CAM_URL=http://<ip>/cgi-bin/snapshot.cgi?channel=1
#   IP_CAM_AUTH=digest
#   RTSP_URL=rtsp://<user>:<pass>@<ip>:554/cam/realmonitor?channel=1&subtype=0
# Zoom motorizado/foco dessas cameras: tools/intelbras_zoom.py (devVideoInput.cgi).
IP_CAM_URL=http://192.168.0.142:80/snap.jpg
IP_CAM_USER=admin
IP_CAM_PASS=admin
# none | basic | digest | auto  (auto tenta basic e cai para digest no 401)
IP_CAM_AUTH=auto
# Stream RTSP usado pelo buffer de video (item #3).
RTSP_URL=rtsp://admin:admin@192.168.0.142:554/stream1

# ---- Cadencia ----
# Segundos entre frames. Piso absoluto de 5s e aplicado no codigo.
CAPTURE_INTERVAL=5
UPLOAD_TIMEOUT=30
CAM_TIMEOUT=10

# ---- Buffer local de frames (resiliencia offline + CMD_BULK_UPLOAD) ----
SPOOL_DIR=/var/spool/saira/frames
KEEP_FRAMES=40
BACKLOG_PER_CYCLE=5

# ---- Buffer de video RTSP e clip sob demanda (item #3) ----
# tmpfs (RAM) para nao desgastar o SD. Veja saira-rtsp-buffer.service.
VIDEO_SEG_DIR=/dev/shm/saira/segments
VIDEO_CLIP_SECONDS=120
# Tamanho de cada segmento .ts (s) e quantos manter no ring (usado pelo .service).
VIDEO_SEG_SECONDS=2
VIDEO_SEG_WRAP=70

# ---- Snapshot via RTSP (substitui o snapshot HTTP flaky da câmera) ----
# O cam-rtsp-buffer.sh decodifica só os keyframes do stream (~1 a cada 1-2s)
# e mantém um JPEG atômico em SNAPSHOT_JPG; o agente lê dele.
# auto = RTSP com fallback HTTP | rtsp = só RTSP | http = só HTTP (legado)
SNAPSHOT_SOURCE=auto
SNAPSHOT_FROM_RTSP=true
SNAPSHOT_JPG=/dev/shm/saira/latest.jpg
# Largura do JPEG gerado (1280 casa com a referência dos polígonos) e qualidade mjpeg.
SNAPSHOT_WIDTH=1280
SNAPSHOT_QUALITY=4
# Idade máxima do latest.jpg antes de cair para o snapshot HTTP.
SNAPSHOT_MAX_AGE=8

# ---- Polling ----
CONFIG_POLL_INTERVAL=60
COMMAND_POLL_TIMEOUT=25

# ---- Motion gate (BGSUB streaming, ver motion_gate.py) ----
# off    = comportamento legado (1 frame a cada CAPTURE_INTERVAL)
# shadow = gate roda e loga decisões + arquiva clipes, uploads continuam legados
# on     = burst durante eventos + heartbeat esparso no idle
MOTION_ENABLED=off
# Cadência de ANÁLISE local em segundos (não custa 4G; piso 1s).
IDLE_ANALYZE_INTERVAL=2.0
# Intervalo entre uploads durante um evento (burst). Com EVENT_BATCH_SIZE>=2
# vira só a cadência de CAPTURA do evento (o upload é em lote, não por frame).
BURST_UPLOAD_INTERVAL=1.5
# Envio em lote dos frames do evento: 0/1 = legado (1 POST por frame); >=2
# acumula N frames e sobe num único POST /upload-batch (ou no fim do evento).
# Limita o delay a N frames mesmo em eventos longos e amortiza o 4G.
EVENT_BATCH_SIZE=0
# Upload esparso no idle para a câmera constar como online.
HEARTBEAT_INTERVAL=60
# image = legado (sobe 1 frame no idle); keepalive = só um POST leve /keepalive
# (sem imagem) — corta 4G; a câmera fica online pelo marcador e a imagem do
# painel vem de evento/sob demanda. Para a Pi event-driven, use keepalive.
HEARTBEAT_MODE=image
# Baseline refeita a cada boot: duração do warm-up do MOG2.
WARMUP_SECONDS=90
# Evento encerra após N s sem MOVIMENTO (delta frame-a-frame) na zona.
EVENT_END_QUIET_SECONDS=10
# Duração máxima de um evento (fecha e reabre se o movimento continuar).
EVENT_MAX_SECONDS=120
# Polígono da zona (JSON compacto, referência 1280x720). Normalmente vem
# do config remoto (POST /device/<id>/config, chave pile_zone_polygon).
PILE_ZONE_POLYGON=

# ---- Parâmetros BGSUB (na escala do frame analisado: 360p) ----
PI_BGSUB_HISTORY=80
PI_BGSUB_VAR_THRESHOLD=40
PI_BGSUB_SHADOW_THRESHOLD=100
# Foreground mínimo em px na zona para contar frame como ativo (dispara evento).
PI_BGSUB_MIN_PX_ACTIVE=200
# Delta frame-a-frame mínimo em px para considerar "ainda em movimento".
PI_BGSUB_DELTA_MIN_PX=100
# Frames ativos consecutivos para abrir evento.
PI_BGSUB_CONSEC_START=2
# Learning rates: idle absorve devagar; recover absorve o depósito julgado.
PI_BGSUB_LR_IDLE=0.005
PI_BGSUB_LR_RECOVER=0.05
# Recover sem convergir por N s -> re-anchor (warm-up silencioso).
PI_BGSUB_RECOVER_MAX_S=180
# Pré-filtro transiente: evento que FECHA com fg residual < este valor é
# tratado como passagem (nada novo na zona) e NÃO é mandado ao Gemini.
# Descarte real fecha com fg alto (objeto recém-largado). Tunável ao vivo
# via config remoto (chave event_min_residual_px).
PI_EVENT_MIN_RESIDUAL_PX=250

# ---- Clipes de evento (RAM -> SD -> upload sob demanda) ----
# Arquivo em RAM (tmpfs): clipes de eventos recentes aguardando confirmação.
ARCHIVE_DIR=/dev/shm/saira/archive
ARCHIVE_MAX_BYTES=209715200
# Persistência no SD: só quando o worker confirma (CMD_PERSIST_CLIP).
CLIPS_DIR=/var/lib/saira/clips
CLIP_RETENTION_DAYS=7
# Contexto antes/depois do evento incluído no clipe.
PRE_ROLL_SECONDS=30
TAIL_SECONDS=6
# Cadeia de clipes: uma ocorrência longa é fatiada pelo gate em eventos
# consecutivos (close:max_duration -> reopen com event_id novo). Com a
# cadeia ligada, a confirmação de UM membro (CMD_PERSIST_CLIP) persiste
# também os vizinhos, um evento que fecha vizinho de clipe já confirmado
# persiste na hora, e o CMD_VIDEO_CLIP costura a cadeia num mp4 único.
# false = comportamento antigo exato. Hot-reload via config remoto:
# clip_chain_enabled / clip_chain_gap_s / clip_chain_max_s / clips_max_mb.
CLIP_CHAIN_ENABLED=true
# Gap máximo (s) entre o fim ESTIMADO de um evento e o início do próximo
# para pertencerem à mesma cadeia (default = PI_BGSUB_RECOVER_MAX_S).
CLIP_CHAIN_GAP_S=180
# Teto de duração (s) do vídeo costurado no CMD_VIDEO_CLIP (limita o 4G).
CLIP_CHAIN_MAX_S=600
# Teto de bytes dos clipes no SD (LRU — backstop: FP não enche o cartão).
CLIPS_MAX_BYTES=8589934592

# ---- Log ----
# Nivel pode ser ajustado em runtime via config remoto (chave log_level).
LOG_LEVEL=INFO
# Log rotativo em arquivo (alem do journal) — o CMD_GET_LOGS le deste arquivo.
LOG_FILE=/var/log/saira/agent.log
LOG_MAX_BYTES=2097152
LOG_BACKUP_COUNT=5

# ---- Observabilidade / auto-cura (deploy remoto) ----
# Versao reportada na telemetria de saude (sobrescreva no deploy, ex.: git sha).
# AGENT_VERSION=field-hardening-2026-06-21
# Watchdog interno: reinicia o processo (systemd sobe de novo) se uma thread
# travar ou se ficar 'vivo mas mudo' (sem contato com o servidor). 0 desliga.
WATCHDOG_TICK=15
WATCHDOG_CAPTURE_STALL=90
WATCHDOG_MUTE_RESTART=600
# Piso de espaco livre (MB) antes de podar agressivamente clipes/spool e alertar.
MIN_DISK_FREE_MB=200
