# Normalize line endings
* text=auto

# Force LF for source files
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Shell scripts and systemd units must stay LF (CRLF breaks them on Linux)
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
